# Скопируйте в .env и заполните — секреты не должны попадать в git (см. .gitignore).

# GitHub token с правами pull_requests:read и pull_requests:write (только комментарии).
GITHUB_TOKEN=

# --- LLM (Polza.ai или любой другой OpenAI-Chat-Completions-совместимый эндпоинт) ---
# Три поля, всегда вместе (см. docs/specs/serving-config.md, "LLM endpoint"):
# URL / токен / имя модели. По умолчанию — Polza.ai (polza.ai/dashboard),
# унифицированный прокси к ~400 моделям (OpenAI, Anthropic, Google и т.д.)
# через единый OpenAI-совместимый формат запросов. Если не заданы —
# оркестратор использует fallback-режим (отчёт только по результатам
# static-analysis инструментов, см. docs/system-design.md, раздел 7
# "Failure modes, fallback, guardrails").
LLM_BASE_URL=https://polza.ai/api/v1
LLM_AUTH_TOKEN=
LLM_MODEL=openai/gpt-4o
